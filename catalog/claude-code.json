{
  "id": "claude-code",
  "name": "Claude Code",
  "tier": "required",
  "order": 10,
  "description": "Anthropic のコーディングエージェント。ターミナルで claude と打って使います（Claude の有料プランかAPIキーが必要）",
  "approxSizeMB": 220,
  "dependsOn": [],
  "platforms": {
    "darwin": {
      "detect": { "command": "claude", "versionArgs": ["--version"], "knownPaths": ["~/.local/bin/claude"] },
      "install": { "strategy": "officialScript", "url": "https://claude.ai/install.sh", "shell": "bash" },
      "postInstall": [{ "ensurePath": "~/.local/bin" }]
    },
    "win32": {
      "detect": { "command": "claude", "versionArgs": ["--version"], "knownPaths": ["~\\.local\\bin\\claude.exe"] },
      "install": { "strategy": "officialScript", "url": "https://claude.ai/install.ps1", "shell": "powershell" },
      "postInstall": [{ "ensurePath": "~\\.local\\bin" }]
    }
  },
  "login": {
    "command": ["claude", "auth", "login"],
    "status": { "command": ["claude", "auth", "status"], "loggedInExitCode": 0 }
  }
}
