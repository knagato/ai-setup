{
  "id": "opencode",
  "name": "OpenCode",
  "tier": "optional",
  "group": "agent",
  "order": 24,
  "description": "オープンソースのコーディングエージェント。ターミナルで opencode と打って使います（無料のモデルですぐ試せます。各社の API キーもつなげます）",
  "approxSizeMB": 50,
  "dependsOn": [],
  "platforms": {
    "darwin": {
      "detect": {
        "command": "opencode",
        "versionArgs": ["--version"],
        "knownPaths": ["~/.local/bin/opencode", "~/.opencode/bin/opencode", "/opt/homebrew/bin/opencode", "/usr/local/bin/opencode"]
      },
      "install": {
        "strategy": "archiveBinary",
        "format": "zip",
        "root": "",
        "bins": ["opencode"],
        "release": {
          "type": "githubDigest",
          "repo": "anomalyco/opencode",
          "url": "https://github.com/anomalyco/opencode/releases/download/v{version}/opencode-darwin-{arch}.zip"
        },
        "fallback": {
          "version": "1.19.0",
          "sha256": {
            "arm64": "0d5f511948d6fbfedf9bb16753c0ac42613dcc8de75d9deb7e8d0cf584c8fba6",
            "x64": "515380b03f3410f2178c8c1c7ba6d1e9556a3bdee2a01d114e7b1681952131a0"
          }
        }
      },
      "postInstall": [{ "ensurePath": "~/.local/bin" }]
    }
  },
  "unsupportedReason": { "win32": "Windows 版は準備中です" }
}
