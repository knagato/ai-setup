{
  "id": "node",
  "name": "Node.js",
  "tier": "recommended",
  "order": 60,
  "description": "多くの AI ツールや拡張機能が動くのに使う土台（長期サポート版）。node・npm・npx が使えるようになります",
  "approxSizeMB": 50,
  "dependsOn": [],
  "platforms": {
    "darwin": {
      "detect": {
        "command": "node",
        "versionArgs": ["--version"],
        "knownPaths": ["~/.local/bin/node", "/opt/homebrew/bin/node", "/usr/local/bin/node"]
      },
      "install": {
        "strategy": "archiveBinary",
        "format": "tar.gz",
        "root": "node-v{version}-darwin-{arch}",
        "bins": ["bin/node", "bin/npm", "bin/npx"],
        "release": {
          "type": "nodeLts",
          "url": "https://nodejs.org/dist/v{version}/node-v{version}-darwin-{arch}.tar.gz",
          "checksums": "https://nodejs.org/dist/v{version}/SHASUMS256.txt"
        },
        "fallback": {
          "version": "24.21.0",
          "sha256": {
            "arm64": "bed7eea5325e1108f32ce5228ddd6a5f0f08a499ee42aa7442aea583702f6057",
            "x64": "1462cb3b3046b815cf8ea436d3da450ec1a9f11dac7e5a46b0ada5305d7e8097"
          }
        }
      },
      "postInstall": [{ "ensurePath": "~/.local/bin" }]
    }
  },
  "unsupportedReason": { "win32": "Windows 版は準備中です" }
}
